# Public browser settings: okay to expose only the publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_publishable_key

# Server-only secret key used by the password-protected Teacher Dashboard endpoint.
# Never prefix this with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_secret_key
# For older Supabase projects, SUPABASE_SERVICE_ROLE_KEY may be used instead.
# SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Teacher Dashboard server-side password gate.
TEACHER_DASHBOARD_PASSWORD=replace-with-a-strong-unique-password
TEACHER_DASHBOARD_SECRET=replace-with-at-least-32-random-characters
